# ==========================================================
# VOISINI — ortam değişkenleri
# Bu dosyayı ".env.local" olarak kopyalayın ve doldurun.
# .env.local ASLA git'e gönderilmez.
# ==========================================================

# --- Supabase (zorunlu) -----------------------------------
# Supabase panelinde: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Yalnızca sunucu tarafı. ASLA istemciye sızmamalı.
# Webhook / bakım görevleri için gerekir (RLS'i atlar).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Site ------------------------------------------------
# Üretimde: https://voisini.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Geocoding (isteğe bağlı) ----------------------------
# Nominatim kullanım politikası bir iletişim adresi ister.
NOMINATIM_EMAIL=contact@voisini.com

# --- Ödeme (Stripe) --------------------------------------
# Boş bırakılırsa online ödeme kapalı kalır; platform "elden ödeme"
# moduyla sorunsuz çalışmaya devam eder.
#
# Test için: Stripe panelinde "Test mode" açıkken sk_test_ ile başlayan anahtar
STRIPE_SECRET_KEY=
# Webhook ucunu (https://voisini.com/api/payments/webhook) eklediğinde alırsın
STRIPE_WEBHOOK_SECRET=
# Platform komisyonu, baz puan cinsinden. 250 = %2,5. Boş/0 = komisyon yok.
PLATFORM_FEE_BPS=0
